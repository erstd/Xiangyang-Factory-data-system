<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="../styles/common.css">
  <link rel="stylesheet" href="../styles/goods.css">
</head>
<body>
  <div class="goods-processing">
    <!-- 搜索区域 -->
    <div class="card search-card">
      <form class="search-form" id="searchForm">
        <div class="form-inline">
          <label>货物类型</label>
          <select id="goodsType">
            <option value="">全部</option>
            <option value="织纱">织纱</option>
            <option value="织片">织片</option>
          </select>

          <label>关键词</label>
          <input type="text" id="keyword" placeholder="搜索客户名称/款号...">

          <button type="button" class="btn btn-primary" onclick="handleSearch()">搜索</button>
          <button type="button" class="btn" onclick="handleReset()">重置</button>
        </div>
      </form>
    </div>

    <!-- 操作按钮 -->
    <div class="card action-card">
      <button class="btn btn-success" onclick="handleAdd()">新增记录</button>
      <button class="btn btn-warning" onclick="handleEdit()">修改记录</button>
      <button class="btn btn-danger" id="deleteBtn" onclick="handleDelete()">删除记录</button>
    </div>

    <!-- 数据表格 -->
    <div class="card table-card">
      <div class="table-wrapper">
        <table id="dataTable">
          <thead>
            <tr>
              <th width="50"><input type="checkbox" id="selectAll"></th>
              <th width="60">ID</th>
              <th width="80">类型</th>
              <th width="150">客户名称</th>
              <th width="130">客户款号</th>
              <th width="110">客户发货量</th>
              <th width="110">工厂收货量</th>
              <th width="100">收发差异</th>
              <th width="110">工厂出货量</th>
              <th width="110">客户收货量</th>
              <th width="100">厂客差异</th>
              <th width="160">最后更新</th>
              <th width="100">操作人</th>
            </tr>
          </thead>
          <tbody id="tableBody">
          </tbody>
        </table>
      </div>

      <!-- 统计信息 -->
      <div class="statistics" id="statistics"></div>
    </div>
  </div>

  <!-- 新增/编辑对话框 -->
  <div id="dialog" class="dialog">
    <div class="dialog-content">
      <div class="dialog-header">
        <h3 id="dialogTitle">新增货品记录</h3>
        <button class="dialog-close" onclick="closeDialog()">&times;</button>
      </div>
      <div class="dialog-body">
        <form id="goodsForm">
          <div class="form-section" id="goodsTypeSection">
            <label>货物类型 *</label>
            <select id="formGoodsType" required>
              <option value="织纱">织纱</option>
              <option value="织片">织片</option>
            </select>
          </div>

          <div class="divider">📦 客户发货信息</div>
          <div class="form-row">
            <div class="form-item">
              <label>客户名称 *</label>
              <input type="text" id="customerName" required>
            </div>
            <div class="form-item">
              <label>客户款号</label>
              <input type="text" id="customerStyleNo">
            </div>
          </div>

          <div class="form-row">
            <div class="form-item">
              <label>发货时间</label>
              <input type="date" id="customerSendDate">
            </div>
            <div class="form-item">
              <label>运输方式</label>
              <select id="customerSendMethod">
                <option value="快递">快递</option>
                <option value="物流">物流</option>
                <option value="自提">自提</option>
                <option value="其他">其他</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-item">
              <label>发货数量 *</label>
              <input type="number" id="customerSendQty" min="0" value="0" required>
            </div>
          </div>

          <div class="divider">🏭 工厂收货信息</div>
          <div class="form-row">
            <div class="form-item">
              <label>收货数量</label>
              <input type="number" id="factoryReceiveQty" min="0" value="0">
            </div>
            <div class="form-item">
              <label>收发差异</label>
              <input type="text" id="diffReceive" readonly>
            </div>
          </div>

          <div class="divider">🚚 工厂出货信息</div>
          <div class="form-row">
            <div class="form-item">
              <label>出货时间</label>
              <input type="date" id="factorySendDate">
            </div>
            <div class="form-item">
              <label>运输方式</label>
              <select id="factorySendMethod">
                <option value="快递">快递</option>
                <option value="物流">物流</option>
                <option value="自提">自提</option>
                <option value="其他">其他</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-item">
              <label>出货数量</label>
              <input type="number" id="factorySendQty" min="0" value="0">
            </div>
          </div>

          <div class="divider">✅ 客户收货信息</div>
          <div class="form-row">
            <div class="form-item">
              <label>收货数量</label>
              <input type="number" id="customerReceiveQty" min="0" value="0">
            </div>
            <div class="form-item">
              <label>厂客差异</label>
              <input type="text" id="diffFactoryCustomer" readonly>
            </div>
          </div>
        </form>
      </div>
      <div class="dialog-footer">
        <button class="btn" onclick="closeDialog()">取消</button>
        <button class="btn btn-primary" onclick="handleSubmit()">保存</button>
      </div>
    </div>
  </div>

  <script src="../js/goods.js"></script>
</body>
</html>
