.login-container {
  width: 100%;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.login-card {
  width: 420px;
  padding: 40px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
}

.login-header {
  text-align: center;
  margin-bottom: 32px;
}

.icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.title {
  font-size: 24px;
  font-weight: 600;
  color: #212121;
  margin-bottom: 8px;
}

.subtitle {
  font-size: 14px;
  color: #757575;
}

.login-form {
  margin-top: 24px;
}

.form-item {
  margin-bottom: 20px;
}

.form-item input {
  width: 100%;
  height: 46px;
  padding: 0 16px;
  font-size: 15px;
}

.login-button {
  width: 100%;
  height: 46px;
  margin-top: 8px;
  font-size: 16px;
  font-weight: 600;
  background: #409EFF;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.3s;
}

.login-button:hover {
  background: #66b1ff;
}

.login-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.login-tip {
  margin-top: 20px;
  text-align: center;
  font-size: 13px;
  color: #9E9E9E;
}
