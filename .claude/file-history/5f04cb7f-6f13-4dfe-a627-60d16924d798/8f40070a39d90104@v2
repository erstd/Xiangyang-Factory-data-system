.goods-processing {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.search-form {
  margin: 0;
}

.form-inline {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.form-inline label {
  margin: 0;
  font-weight: 500;
}

.form-inline select,
.form-inline input {
  width: auto;
}

.form-inline select {
  min-width: 120px;
}

.form-inline input[type="text"] {
  min-width: 240px;
}

.action-card {
  display: flex;
  gap: 12px;
}

.table-card {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.statistics {
  margin-top: 16px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.tag {
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
}

.tag-info {
  background: #E3F2FD;
  color: #1976D2;
}

.tag-success {
  background: #E8F5E9;
  color: #388E3C;
}

.tag-warning {
  background: #FFF3E0;
  color: #F57C00;
}

.diff-positive {
  color: #4CAF50;
}

.diff-negative {
  color: #F44336;
}

.diff-zero {
  color: #616161;
}
