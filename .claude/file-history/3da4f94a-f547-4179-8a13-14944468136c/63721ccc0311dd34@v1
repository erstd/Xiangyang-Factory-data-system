package server

import (
	"chatapp/backend/cache"
	"chatapp/backend/config"
	"chatapp/backend/kafka"
	"chatapp/backend/log"
	"chatapp/backend/protocal"
	"github.com/gorilla/websocket"
	"github.com/gogo/protobuf/proto"
)

type ClientWs struct{
/*
	负责管理已经和服务器连接上的客户端，负责每个客户端的读和写
*/
	Conn *websocket.Conn
	Name string
	Send chan []byte
}

func (c *ClientWs) Read() {
	defer func() {
		AppServer.Unregister <- c
		c.Conn.Close()
	}()

	for {
		_, message, err := c.Conn.ReadMessage()
		if err != nil {
			log.Logger.Error("client read message error", log.Any("client read message error", err.Error()))
			AppServer.Unregister <- c
			c.Conn.Close()
			break
		}

		msg := &protocol.Message{}
		if err := proto.Unmarshal(message, msg); err != nil {
			log.Logger.Error("client unmarshal message error", log.Any("error", err))
			continue
		}
		if err := cache.RefreshUserOnline(c.Name); err != nil {
			log.Logger.Warn("refresh user online failed", log.String("user", c.Name), log.Any("error", err))
		}

		// pong
		if msg.Type == config.HEAT_BEAT {
			pong := &protocol.Message{
				Content: config.PONG,
				Type:    config.HEAT_BEAT,
			}
			pongByte, err2 := proto.Marshal(pong)
			if nil != err2 {
				log.Logger.Error("client marshal message error", log.Any("client marshal message error", err2.Error()))
			}
			if err := c.Conn.WriteMessage(websocket.BinaryMessage, pongByte); err != nil {
				log.Logger.Error("client write pong error", log.Any("error", err))
				break
			}
		} else {
			if config.GetConfig().Msg_trans_channel == config.KAFKA {
				if err := kafka.Push(message); err != nil {
					log.Logger.Error("kafka send failed, fallback go channel", log.Any("error", err))
					AppServer.Broadcast <- message
				}
			} else {
				AppServer.Broadcast <- message
			}
		}
	}
}

func (c *ClientWs) Write() {
	defer func() {
		c.Conn.Close()
	}()

	for message := range c.Send {
		if err := c.Conn.WriteMessage(websocket.BinaryMessage, message); err != nil {
			log.Logger.Error("client write message error", log.Any("error", err))
			break
		}
	}
}
