    def refresh_data(self):
        """刷新数据"""
        # 获取当前活动的标签页
        current_tab = self.centralWidget().findChild(QTabWidget).currentWidget()
        if hasattr(current_tab, 'refresh'):
            current_tab.refresh()
            QMessageBox.information(self, '提示', '数据刷新成功！')

    def logout(self):
